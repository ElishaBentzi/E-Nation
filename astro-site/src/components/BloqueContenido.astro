---
/*
 * UN BLOQUE DE CONTENIDO (un widget de Elementor ya traducido a modelo).
 *
 * POR QUE VIVE EN COMPONENTE PROPIO
 *   Elementor permite meter una SECCION dentro de una columna, y esa seccion trae
 *   sus propias columnas y widgets. Pintar eso exige recursión —un grupo que contiene
 *   columnas que contienen bloques, uno de los cuales puede ser otro grupo— y un
 *   `switch` dentro de una plantilla no puede llamarse a sí mismo. Aqui sí: el caso
 *   `grupo` se vuelve a renderizar a este mismo componente.
 *
 * EL CASO `grupo`
 *   Una sección interna NO es una fila hermana de las columnas de fuera: es un BLOQUE
 *   dentro de su columna. Subirla de nivel era el fallo que hacía que el reparto por
 *   filas sumara 200 % (14 + 72 + 100 + 14) y una sección de 652 px midiera 3116.
 *
 * LOS ESTILOS DEL CARRIL VAN AQUI CON `is:global`
 *   Los estilos con ámbito de Astro se dedican por componente; si el carril se
 *   pintara desde dos componentes, el segundo saldría sin estilos y sin ningún error.
 *   Las clases ya tienen namespace propio (`contenedor-columnas`, `columna`), así que
 *   globalizarlas no pisa nada.
 */
import BloqueContenido from './BloqueContenido.astro';
import BannerSlider from '../../../shared/banner-slider/BannerSlider.astro';
import JetSlider from '../../../shared/jet-slider/JetSlider.astro';
import FormularioSuscripcion from './FormularioSuscripcion.astro';
import TextoAnimado from './TextoAnimado.astro';
import type { Locale } from '../i18n/config.ts';
import { rutaDe } from '../i18n/config.ts';

interface Props {
  bloque: any;
  locale: Locale;
}
const { bloque, locale } = Astro.props;

/* El margen y el relleno que el autor puso ALREDEDOR de este bloque: es el aire entre
   piezas, no un adorno. */
const estBloque = [
  bloque.margen ? `margin:${bloque.margen}` : '',
  bloque.relleno ? `padding:${bloque.relleno}` : '',
].filter(Boolean).join(';') || undefined;

---
<style is:global>
  /*
   * LA REJILLA DE COLUMNAS.
   *
   * Cien columnas de una fraccion cada una, y cada columna de la seccion ocupa tantas
   * como diga su ancho. El hueco entre columnas se hace con RELLENO INTERIOR, no con
   * `gap`: con `gap`, tres columnas del 33 % mas dos huecos suman mas del 100 % y la
   * tercera se cae a la fila siguiente.
   */
  .contenedor-columnas {
    display: grid;
    grid-template-columns: repeat(100, minmax(0, 1fr));
  }
  .columna {
    grid-column: span 100;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-inline: 0.5rem;
    padding-block: 0.5rem;
  }
  @media (min-width: 768px) {
    .columna {
      grid-column: span var(--columnas, 100);
    }
  }
  /* Un grupo en posicion de columna (seccion dentro de seccion directa) ocupa el
     ancho completo del carril: sin esto, entra en la rejilla ocupando 1/100 y su
     contenido se estruja en una columna estrechisima. */
  .contenedor-columnas > .grupo {
    grid-column: 1 / -1;
  }

  /*
   * TARJETAS DEL EFECTO `roxy`. La imagen es mas ancha que la tarjeta y se
   * desplaza a la izquierda; es lo que da la altura y el recorte del original.
   * El titulo va a ~27 % de la altura y la descripcion aparece al pasar el raton.
   */
  .banner-tarjeta__imagen {
    width: 111.3%;
    max-width: none;
    margin-inline-start: -5.65%;
    transition: transform 350ms ease;
  }
  .banner-tarjeta:hover .banner-tarjeta__imagen {
    transform: translateX(5.65%);
  }
  .banner-tarjeta__titulo {
    top: 27%;
    font-weight: 500;
    line-height: 1.2;
  }
  .banner-tarjeta__texto {
    top: 36%;
  }

  /* Hover del boton de JetElements: fondo naranja declarado en el original. */
  .boton-jet:hover {
    background-color: var(--boton-hover, #ff7100) !important;
  }
</style>

{(() => {
  const estTitulo = [
    bloque.color ? `color:${bloque.color}` : '',
    bloque.tamanoEm ? `font-size:${bloque.tamanoEm}em` : '',
    bloque.grosor ? `font-weight:${bloque.grosor}` : '',
    bloque.interlineadoEm ? `line-height:${bloque.interlineadoEm}` : '',
    bloque.alineacion === 'center' ? 'text-align:center' : '',
    bloque.fondo ? `background-color:${bloque.fondo}` : '',
    bloque.sombra ? `text-shadow:${bloque.sombra}` : '',
  ].filter(Boolean).join(';') || undefined;

  switch (bloque.tipo) {
    case 'grupo':
      /*
       * SECCION INTERNA: su fondo y su relleno son suyos, y dentro trae un carril de
       * columnas con mas bloques. La recursión esta aqui.
       */
      return (
        <div class="grupo relative w-full" style={bloque.fondo?.color ? `background-color:${bloque.fondo.color}` : undefined}>
          {bloque.fondo?.velo && (
            <div class="pointer-events-none absolute inset-0" style={`background-color:${bloque.fondo.velo}`} />
          )}
          <div
            class="contenedor-columnas relative mx-auto w-full max-w-[1140px]"
            style={bloque.relleno ? `padding:${bloque.relleno}` : undefined}
          >
            {(bloque.columnas as any[]).map((columna) => (
              <div class="columna" style={`--columnas:${Math.max(1, Math.round(columna.ancho || 100))};${columna.relleno ? `padding:${columna.relleno};` : ''}`}>
                {(columna.bloques as any[]).map((interno: any) => (
                  <BloqueContenido bloque={interno} locale={locale} />
                ))}
              </div>
            ))}
          </div>
        </div>
      );

    case 'encabezado': {
      const Etiqueta = (bloque.nivel || 'h2') as any;
      /* Cuando el autor partio el texto en varias lineas, el salto se conserva con
         `set:html`. El marcado ya viene reducido a una lista blanca minima desde el
         extractor (`<br>`, `<strong>`, `<em>`). */
      const estilo = [estTitulo, estBloque].filter(Boolean).join(';') || undefined;
      return bloque.html
        ? <Etiqueta style={estilo} set:html={bloque.html} />
        : <Etiqueta style={estilo}>{bloque.texto}</Etiqueta>;
    }

    case 'texto':
    case 'html':
      return <div class="prosa" style={estBloque} set:html={bloque.html} />;

    case 'formulario':
      /* Suscripcion a la lista de Mailchimp: la cuenta y los campos son los del
         original; el formulario es el componente AJAX sin jQuery. */
      return <div style={estBloque}><FormularioSuscripcion locale={locale} /></div>;

    case 'banner':
      /*
       * TARJETA DEL EFECTO `roxy` DE JETELEMENTS, medida en el original:
       *
       *   - la imagen mide el 111,3 % del ancho de la tarjeta y se desplaza -50 px
       *     (5,6 %) a la izquierda; eso da la altura de la tarjeta (599 px para un
       *     ancho de 539) y el recorte lateral que se ve.
       *   - el título va centrado a ~27 % de la altura, a 37,5 px (2,5 em).
       *   - la descripción está OCULTA y aparece al pasar el ratón sobre un velo
       *     negro; el título se queda.
       *   - el título visible NO lleva el velo: comprobado pixel a pixel, la
       *     tarjeta no tiene tinte azul; el aspecto azulado de la captura era el
       *     fondo de la sección, no una capa sobre la imagen.
       */
      return (
        <article
          class:list={['banner-tarjeta group relative overflow-hidden', bloque.clases]}
          style={estBloque}
        >
          {bloque.imagen && (
            <img
              src={bloque.imagen}
              alt=""
              loading="lazy"
              decoding="async"
              class="banner-tarjeta__imagen block h-auto"
            />
          )}
          <div
            class="banner-tarjeta__velo pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-70"
            style={`background-color:${bloque.fondoHover || '#000000'}`}
          />
          <h5
            class="banner-tarjeta__titulo absolute inset-x-0 text-center"
            style={[
              'color:' + (bloque.colorTitulo || '#ffffff'),
              `font-size:${bloque.tamanoTituloEm || 2.5}em`,
            ].join(';')}
          >
            {bloque.titulo}
          </h5>
          {bloque.texto && (
            <p
              class="banner-tarjeta__texto absolute inset-x-0 translate-y-2 p-4 text-center opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100"
              style={[
                'color:' + (bloque.colorTexto || '#ffffff'),
                'font-size:1.5em',
                'line-height:1.2',
              ].join(';')}
            >
              {bloque.texto}
            </p>
          )}
        </article>
      );

    case 'caja':
      /*
       * TARJETA CON IMAGEN Y TÍTULO CENTRADO (`jet-animated-box`).
       *
       * El original pone el marco naranja en la COLUMNA que envuelve al widget
       * (`.elementor-widget-wrap`, `border:2px solid #ff7100; padding:10px`), no
       * en el widget: por eso una inspección del propio widget no encontraba
       * ningún borde. Aquí el marco va en la tarjeta, que es visualmente lo
       * mismo y no obliga a extraer el estilo de la columna.
       *
       * Título a 30 px, peso 600, blanco y CENTRADO, no abajo a la izquierda. La
       * descripción del dorso aparece al pasar el ratón sobre el velo azul.
       */
      return (
        <article
          class="caja-tarjeta group mx-auto w-full max-w-[274px] border-2 border-[#ff7100] p-[10px]"
          style={estBloque}
        >
          <div class="relative aspect-[250/280] w-full overflow-hidden">
            {bloque.imagen && (
              <img src={bloque.imagen} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
            )}
            <h3
              class="absolute inset-0 grid place-items-center p-3 text-center leading-[1.13]"
              style={[
                'color:' + (bloque.colorTitulo || '#ffffff'),
                'font-size:30px',
                'font-weight:600',
                'text-shadow:0 2px 5px rgba(0,0,0,.45)',
              ].join(';')}
            >
              {bloque.titulo}
            </h3>
            <div
              class="absolute inset-0 flex items-center justify-center p-4 text-center opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="background-color:rgba(9,82,135,.92)"
            >
              <p class="text-[15px] leading-snug text-white">
                {bloque.descripcionDorso || bloque.descripcion}
              </p>
            </div>
          </div>
        </article>
      );

    case 'textoAnimado':
      /*
       * Dos líneas: el texto fijo que el extractor antes perdía y la palabra
       * animada. El componente se encarga del efecto `fx2` al entrar en pantalla.
       * Se le pasa `estBloque` (margen del widget), no `estTitulo`: los tamaños y
       * colores de cada línea son distintos y los decide el componente.
       */
      return (
        <TextoAnimado
          antes={bloque.antes}
          despues={bloque.despues}
          palabras={bloque.palabras ?? []}
          color={bloque.color}
          tamanoEm={bloque.tamanoEm}
          colorAntes={bloque.colorAntes}
          tamanoAntesEm={bloque.tamanoAntesEm}
          retardoMs={bloque.retardoMs ?? 400}
        />
      );

    case 'lista':
      return (
        <ul class="ms-5 list-disc space-y-2" style={estBloque}>
          {(bloque.items as string[]).map((x) => <li>{x}</li>)}
        </ul>
      );

    case 'imagen':
      return bloque.imagen ? (
        /* A TAMANO NATURAL y centrada, como la pinta Elementor: estirarla a
           `w-full` multiplicaba su tamano (un pasaporte de 300x291 se renderizaba a
           1224 de ancho). `self-center` es imprescindible: la columna es flex y con
           `align-items: stretch` la imagen se estiraba al ancho del carril aunque
           su ancho natural fuera 300 (el logo de YouTube salia a 896 px). */
        <img src={bloque.imagen} alt={bloque.alt || ''} loading="lazy" decoding="async"
          class="mx-auto block h-auto w-auto max-w-full self-center rounded" style={estBloque} />
      ) : null;

    case 'boton': {
      /* Boton de JetElements: cuando declara colores, se usan los suyos (fondo,
         borde y tamano de letra medidos); si no, se mantiene el CTA del tema. */
      const estiloBoton = bloque.fondo
        ? [
            `background-color:${bloque.fondo}`,
            'color:#ffffff',
            bloque.borde ? `border:${bloque.borde}` : 'border:0',
            `font-size:${bloque.tamanoEm || 1.5}em`,
            'font-weight:600',
            'line-height:1',
            'padding:0.6em 1em',
            bloque.fondoHover ? `--boton-hover:${bloque.fondoHover}` : '',
            bloque.alineacion === 'center' ? 'margin-inline:auto' : '',
            estBloque ?? '',
          ].filter(Boolean).join(';')
        : undefined;
      return (
        <a
          href={bloque.enlace || rutaDe('presentation', locale)}
          class:list={[
            'inline-flex w-fit items-center gap-2 rounded font-semibold text-white',
            bloque.fondo ? 'boton-jet' : 'bg-brand px-6 py-3',
          ]}
          style={estiloBoton ?? estBloque}
          {...(bloque.enlace && /^https?:/.test(bloque.enlace) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {bloque.etiqueta}
        </a>
      );
    }

    case 'slider': {
      const s = bloque._slider;
      /*
       * El hero (`e-nation`) va a ANCHO COMPLETO: el original lo renderiza a 1425
       * px, no a los 1140 del contenedor. Los sliders decorativos y el carrusel
       * de banners NO: van dentro de su columna.
       */
      const anchoCompleto = s?.alias === 'e-nation';
      return s ? (
        <BannerSlider
          config={s.config}
          etiqueta={s.etiqueta}
          etiquetaAnterior={s.anterior}
          etiquetaSiguiente={s.siguiente}
          clase=""
          anchoCompleto={anchoCompleto}
        />
      ) : null;
    }

    case 'sliderJet':
      return (
        <JetSlider
          items={bloque.items ?? []}
          alto={bloque.alto}
          altoTableta={bloque.altoTableta}
          altoMovil={bloque.altoMovil}
          flechaFondo={bloque.flechaFondo}
          flechaFondoHover={bloque.flechaFondoHover}
          etiqueta={locale === 'es' ? 'Carrusel de tarjetas' : 'Card carousel'}
          etiquetaAnterior={locale === 'es' ? 'Anterior' : 'Previous'}
          etiquetaSiguiente={locale === 'es' ? 'Siguiente' : 'Next'}
        />
      );

    case 'video':
      return bloque.miniatura || bloque.youtube ? (
        <a
          href={bloque.youtube || bloque.vimeo || '#'}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block overflow-hidden rounded"
          style={estBloque}
          data-pendiente="video-emergente"
        >
          {bloque.miniatura && (
            <img src={bloque.miniatura} alt="" loading="lazy" decoding="async" class="h-auto w-full" />
          )}
          <span class="absolute inset-0 grid place-items-center">
            <span class="grid h-14 w-14 place-items-center rounded-full bg-white/80 text-2xl">▶</span>
          </span>
        </a>
      ) : null;

    case 'ancla':
      /* Marca de ancla para la navegacion interna: no pinta nada. */
      return null;

    case 'separador':
      return <hr class="w-full border-t border-current opacity-20" />;

    case 'espacio':
      return <div style={`height:${bloque.alto || 24}px`} aria-hidden="true" />;

    default:
      /* Un widget sin mapear se deja VISIBLE como marca, para que no desaparezca en
         silencio: se ve que existe y que queda pendiente. */
      return (
        <div class="rounded border border-dashed border-current/30 p-2 text-xs opacity-60" data-sin-mapear={bloque.widget}>
          {bloque.widget}
        </div>
      );
  }
})()}
