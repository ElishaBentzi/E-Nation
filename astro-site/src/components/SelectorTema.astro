---
/*
 * Selector de tema: claro / oscuro / auto.
 *
 * TRES ESTADOS, como el de Starlight en la documentacion, no dos. La diferencia
 * importa: con solo dos estados, quien elige "claro" queda clavado en claro y deja
 * de seguir la preferencia del sistema. Con "auto" hay salida.
 *
 * El estado NO se guarda en el marcado: lo aplica el guion en linea del <head>
 * antes del primer pintado, y el manejador de clic vive en el layout. Este
 * componente solo pinta los botones, que es lo que se puede cachear.
 */
import type { Locale } from '../i18n/config.ts';
import { UI } from '../i18n/ui.ts';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];

const opciones = [
  { valor: 'light', etiqueta: t.temaClaro, icono: 'sun' },
  { valor: 'dark', etiqueta: t.temaOscuro, icono: 'moon' },
  { valor: 'auto', etiqueta: t.temaAuto, icono: 'auto' },
] as const;
---

<div class="flex items-center gap-1 rounded border border-border-soft p-0.5 dark:border-[#2a4a6b]" role="group" aria-label={t.temaLabel}>
  {opciones.map((o) => (
    <button
      type="button"
      data-tema={o.valor}
      aria-pressed="false"
      title={o.etiqueta}
      class="rounded px-2 py-1 text-xs text-ink hover:bg-border-soft aria-pressed:bg-brand aria-pressed:text-white dark:text-border-soft dark:hover:bg-[#1c3a57]"
    >
      <span class="sr-only">{o.etiqueta}</span>
      {o.icono === 'sun' && (
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      )}
      {o.icono === 'moon' && (
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
      )}
      {o.icono === 'auto' && (
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 3v18" />
          <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none" />
        </svg>
      )}
    </button>
  ))}
</div>
