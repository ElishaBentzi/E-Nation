---
/*
 * BannerSlider — carrusel de banners con enlaces, en un solo componente.
 *
 * PENSADO PARA REUTILIZARSE. No sabe nada de E-Nation: se alimenta de un JSON con
 * el formato que describe `shared/banner-slider/README.md`, que a su vez se genera
 * desde Slider Revolution con `tools/revslider-to-config.cjs`. Otro proyecto
 * WordPress puede copiar esta carpeta entera y reutilizar el mismo generador.
 *
 * QUE CUBRE
 *   - Slides con imagen de fondo (y variante movil), enlace opcional y capas
 *     encima: texto o imagen, posicionadas, con tamanos por dispositivo.
 *   - Navegacion: flechas, puntos, teclado, y contador.
 *   - Autoplay con pausa al pasar el raton o al recibir el foco.
 *   - Respeta `prefers-reduced-motion`: sin transiciones ni autoplay.
 *   - Accesibilidad: region con `aria-roledescription="carrusel"`, cada slide
 *     anunciado, y los controles con nombre accesible.
 *
 * QUE **NO** CUBRE, A PROPOSITO
 *   Las animaciones de entrada capa por capa de Slider Revolution (fotogramas con
 *   transformaciones por eje y por dispositivo). Replicarlas exigiria arrastrar
 *   toda la complejidad del plugin. En su lugar hay una entrada simple: la capa
 *   aparece con un desplazamiento leve y opcional. El generador AVISA de cuantas
 *   animaciones quedan sin mapear, para que no se pierdan en silencio.
 */
interface Capa {
  uid: number;
  alias?: string | null;
  tipo: 'texto' | 'imagen' | 'forma';
  texto?: string | null;
  /** true si el texto trae HTML del original (texto + icono) y hay que interpretarlo. */
  textoConHtml?: boolean;
  imagen?: string | null;
  alt?: string | null;
  posicion?: {
    horizontal?: string | null;
    vertical?: string | null;
    x?: string | number | null;
    y?: string | number | null;
    porPixeles?: boolean;
    zIndex?: number | null;
  };
  estilos?: {
    familia?: string | null;
    tamano?: string | null;
    grosor?: string | null;
    interlineado?: string | null;
    espaciadoLetras?: string | null;
    alineacion?: string | null;
    color?: string | null;
    preset?: string | null;
  } | null;
  tamano?: { ancho?: string | null; alto?: string | null };
  variantes?: Record<string, { ancho?: string; alto?: string }>;
  enlace?: { href: string; target?: string; externo?: boolean };
  animacion?: {
    desde?: { opacidad?: number; x?: string | null; y?: string | null };
    duracionMs?: number | null;
    retardoMs?: number | null;
  } | null;
  /**
   * Animacion CONTINUA, que se repite mientras el banner esta visible.
   *
   * Es lo que da vida: el corazon que late de Venezuela es `escala: 0.8`, y las
   * monedas de UnityCoin pulsan a `0.95`. Sin esto la capa se queda quieta al
   * terminar la entrada, que es justo lo que se notaba.
   */
  bucle?: { tipo: 'escala' | 'rotacion'; valor: number } | null;
}

interface Slide {
  id: number;
  orden?: number;
  titulo?: string | null;
  enlace?: { href: string; target?: string; externo?: boolean } | null;
  fondo?: { tipo?: string; color?: string | null; imagen?: string | null };
  capas?: Capa[];
}

interface Props {
  config: {
    id: string;
    lienzo?: {
      ancho?: number | string | null;
      alto?: number | string | null;
      anchoMaximo?: number | null;
      variantes?: Record<string, { ancho: number; alto: number }>;
    };
    comportamiento?: {
      autoplay?: boolean;
      intervaloMs?: number | null;
      bucle?: boolean;
      pausaAlPasarRaton?: boolean;
    };
    slides: Slide[];
  };
  /** Texto para lectores de pantalla, ya traducido por quien lo usa. */
  etiqueta: string;
  etiquetaAnterior?: string;
  etiquetaSiguiente?: string;
  clase?: string;
}

const {
  config,
  etiqueta,
  etiquetaAnterior = 'Previous',
  etiquetaSiguiente = 'Next',
  clase = '',
} = Astro.props;

const slides = config.slides ?? [];
const comportamiento = config.comportamiento ?? {};
const lienzo = config.lienzo ?? {};
// La cadena vacia del autoplay se resuelve aqui para que el script reciba un
// dato limpio y no tenga que adivinar.
const intervalo = comportamiento.intervaloMs && comportamiento.intervaloMs > 500
  ? comportamiento.intervaloMs
  : 6000;

/**
 * Identificador unico para el <style> del lienzo. Se deriva del id de la config
 * para que dos sliders en la misma pagina no se pisen las reglas.
 */
const idCss = `bs-${String(config.id || 'x').replace(/[^a-z0-9-]/gi, '')}`;

/**
 * Relacion de aspecto del lienzo, con sus variantes por dispositivo.
 *
 * ES LO QUE EVITA QUE EL SLIDER COLAPSE. Sin alto declarado el contenedor mide 0,
 * los slides absolutos se apilan fuera de su sitio y aparecen encima del pie de
 * pagina. Es un fallo puramente visual: el build pasa y el HTML es correcto, asi
 * que solo se ve mirando la pagina.
 *
 * Los puntos de corte siguen los dispositivos de RevSlider (escritorio, portatil,
 * tableta, movil) y van de mayor a menor para que gane el ultimo que coincida.
 */
const CORTES = [
  { clave: 'portatil', max: 1199 },
  { clave: 'tableta', max: 1023 },
  { clave: 'movil', max: 767 },
];
const reglasLienzo = [];
// Si el original limita el ancho, se respeta: las capas estan posicionadas en
// pixeles relativos a ESE lienzo, asi que estirarlo a todo el ancho de la ventana
// cambia la escala de todo el banner.
if (lienzo.anchoMaximo) {
  reglasLienzo.push(`.${idCss}{max-width:${lienzo.anchoMaximo}px;margin-inline:auto;}`);
}
if (lienzo.ancho && lienzo.alto) {
  reglasLienzo.push(`.${idCss}{aspect-ratio:${lienzo.ancho}/${lienzo.alto};}`);
}
for (const c of CORTES) {
  const v = lienzo.variantes?.[c.clave];
  if (v?.ancho && v?.alto) {
    reglasLienzo.push(`@media (max-width:${c.max}px){.${idCss}{aspect-ratio:${v.ancho}/${v.alto};}}`);
  }
}

// Dimensiones del lienzo para convertir pixeles a porcentaje. Si la config no las
// trae, se usan las del slider de banners del original, que es el caso conocido.
const anchoLienzo = Number(lienzo.ancho) || 1240;
const altoLienzo = Number(lienzo.alto) || 300;

/**
 * Sanea el HTML de una capa.
 *
 * Seis capas de estos sliders llevan HTML real ("Spanish Edition
 * <i class=\"fa-download\"></i>"): texto mas un icono que el original renderizaba.
 * Mostrarlo escapado ensena el codigo al visitante, asi que hay que interpretarlo.
 *
 * PERO no se inyecta tal cual: se permite solo una lista blanca de etiquetas
 * simples y el atributo `class`. El contenido viene de la base de datos del
 * WordPress del propio cliente, no de un tercero, pero interpretar HTML sin
 * filtrar es una costumbre que no conviene adquirir.
 */
function sanearHtml(html) {
  if (!html) return '';
  return String(html)
    .replace(/<\s*(script|style|iframe|object|embed|form)[\s\S]*?<\s*\/\s*\1\s*>/gi, '')
    .replace(/\son\w+\s*=\s*(?:"[^"]*"|'[^']*'|[^\s>]+)/gi, '')
    .replace(/javascript:/gi, '')
    .replace(/<\s*(\/?)\s*([a-z0-9]+)((?:\s+[^>]*)?)>/gi, (m, cierre, etiqueta, attrs) => {
      const permitidas = ['i', 'b', 'strong', 'em', 'br', 'span', 'small'];
      const t = etiqueta.toLowerCase();
      if (!permitidas.includes(t)) return '';
      if (t === 'br') return '<br>';
      const clase = (String(attrs).match(/\bclass\s*=\s*"([^"]*)"/i) || [])[1];
      const claseLimpia = clase ? clase.replace(/[^a-z0-9 _-]/gi, '') : '';
      return `<${cierre}${t}${claseLimpia ? ` class="${claseLimpia}"` : ''}>`;
    });
}

/**
 * Posicion de una capa.
 *
 * HAY DOS SISTEMAS, y confundirlos manda las capas fuera de sitio:
 *
 *   1. POR PIXELES (`porPixeles`), que es el caso mayoritario: 116 de las 157
 *      capas del slider de banners, y 162 de las 220 de todo el sitio. Las
 *      coordenadas son pixeles desde la esquina superior IZQUIERDA del lienzo.
 *   2. POR ANCLAJE, cuando el original SI declara `horizontal`/`vertical`.
 *
 * Los pixeles se convierten a PORCENTAJE del lienzo para que el banner escale con
 * el contenedor. Dejados en pixeles, al estrecharse la ventana las capas se
 * quedarian clavadas y se saldrian.
 */
function estiloCapa(c: Capa, anchoLienzo: number, altoLienzo: number) {
  const p = c.posicion ?? {};
  const partes = ['position:absolute'];

  const aPct = (valor: unknown, total: number) => {
    if (valor === null || valor === undefined || valor === '') return null;
    const n = parseFloat(String(valor).replace('px', ''));
    if (Number.isNaN(n)) return null;
    return (n / total) * 100;
  };

  if (p.porPixeles) {
    const x = aPct(p.x, anchoLienzo) ?? 0;
    const y = aPct(p.y, altoLienzo) ?? 0;
    // Coordenadas FISICAS (`left`/`top`) a proposito: esto replica una composicion
    // grafica fija, y en un idioma RTL espejar el banner pondria los logos y las
    // formas del reves. No es cromo de la interfaz, es una ilustracion.
    partes.push(`left:${x.toFixed(4)}%`, `top:${y.toFixed(4)}%`);
  } else {
    const anclajesH: Record<string, string> = { left: '0', center: '50%', right: '100%' };
    const anclajesV: Record<string, string> = { top: '0', middle: '50%', bottom: '100%' };
    const h = p.horizontal ?? 'left';
    const v = p.vertical ?? 'top';
    partes.push(`left:${anclajesH[h] ?? '0'}`, `top:${anclajesV[v] ?? '0'}`);
    const tx = h === 'right' ? '-100%' : h === 'center' ? '-50%' : '0';
    const ty = v === 'bottom' ? '-100%' : v === 'middle' ? '-50%' : '0';
    partes.push(`transform:translate(${p.x ? `calc(${tx} + ${p.x})` : tx},${p.y ? `calc(${ty} + ${p.y})` : ty})`);
  }

  if (p.zIndex) partes.push(`z-index:${p.zIndex}`);

  const ancho = aPct(c.tamano?.ancho, anchoLienzo);
  if (ancho) partes.push(`width:${ancho.toFixed(4)}%`);

  /*
   * ANIMACION DE ENTRADA.
   *
   * El ESCALONADO es lo que hace atractivo el banner: en el original las capas
   * entran con retardos de 10 a 870 ms, asi que se va componiendo en vez de
   * aparecer de golpe. Sin el retardo, la animacion se nota mucho menos.
   *
   * La animacion mueve la propiedad `translate`, NO `transform`: las capas con
   * anclaje ya usan `transform` para posicionarse, y las dos propiedades son
   * independientes, asi que no hay conflicto posible. El detalle esta explicado en
   * los fotogramas, mas abajo.
   */
  if (c.animacion) {
    const a = c.animacion;
    if (a.desde?.opacidad !== undefined && a.desde.opacidad !== 1) partes.push(`--bs-op0:${a.desde.opacidad}`);
    if (a.desde?.x) partes.push(`--bs-x0:${a.desde.x}`);
    if (a.desde?.y) partes.push(`--bs-y0:${a.desde.y}`);
    if (a.duracionMs) partes.push(`--bs-dur:${a.duracionMs}ms`);
    if (a.retardoMs) partes.push(`--bs-delay:${a.retardoMs}ms`);
  }

  /*
   * BUCLE: la animacion continua que da vida al banner.
   *
   * Se usan las propiedades INDIVIDUALES `scale` y `rotate`, no `transform`, por el
   * mismo motivo que la entrada usa `translate`: las capas ancladas ya ocupan
   * `transform` para posicionarse, y las propiedades individuales son
   * independientes, asi que no pueden chocar con el.
   */
  if (c.bucle) partes.push(`--bs-loop:${c.bucle.valor}`);

  // Tipografia en unidades de CONTENEDOR (`cqw`): es lo que hace que el texto
  // escale con el banner, como hacia el plugin. El contenedor se declara con
  // `container-type: inline-size` en los estilos del componente.
  const est = c.estilos;
  if (est) {
    const fs = aPct(est.tamano, anchoLienzo);
    if (fs) partes.push(`font-size:${fs.toFixed(4)}cqw`);
    if (est.grosor) partes.push(`font-weight:${est.grosor}`);
    const lh = aPct(est.interlineado, anchoLienzo);
    if (lh) partes.push(`line-height:${lh.toFixed(4)}cqw`);
    if (est.espaciadoLetras && est.espaciadoLetras !== '0px') {
      const ls = aPct(est.espaciadoLetras, anchoLienzo);
      if (ls) partes.push(`letter-spacing:${ls.toFixed(4)}cqw`);
    }
    if (est.familia) partes.push(`font-family:"${est.familia}", sans-serif`);
    if (est.color) partes.push(`color:${est.color}`);
    if (est.alineacion) partes.push(`text-align:${est.alineacion}`);
  }

  return partes.join(';');
}
---

<div
  class:list={['banner-slider relative overflow-hidden', idCss, clase]}
  data-banner-slider
  data-intervalo={intervalo}
  data-autoplay={comportamiento.autoplay ? 'true' : 'false'}
  data-bucle={comportamiento.bucle === false ? 'false' : 'true'}
  data-pausa-hover={comportamiento.pausaAlPasarRaton === false ? 'false' : 'true'}
  role="region"
  aria-roledescription="carrusel"
  aria-label={etiqueta}
>
  {/* Las reglas de aspecto van en un <style> propio en lugar de en el atributo
      `style` porque necesitan puntos de corte, y `style` no admite media queries. */}
  {reglasLienzo.length > 0 && <style set:html={reglasLienzo.join('')} is:inline />}
  <div class="banner-slider__pista relative h-full w-full" data-pista>
    {slides.map((s, i) => {
      const capasConContenido = (s.capas ?? []).filter(
        (c) => (c.tipo === 'texto' && c.texto) || (c.tipo === 'imagen' && c.imagen)
      );
      // El enlace del slide envuelve TODA la superficie: es lo que hace que el
      // banner sea clicable entero y no solo un boton.
      const Etiqueta = s.enlace ? 'a' : 'div';
      return (
        <Etiqueta
          class:list={[
            'banner-slider__slide absolute inset-0 transition-opacity duration-700',
            i === 0 ? 'opacity-100' : 'pointer-events-none opacity-0',
          ]}
          data-slide={i}
          aria-hidden={i === 0 ? 'false' : 'true'}
          aria-label={s.titulo ?? `Slide ${i + 1} de ${slides.length}`}
          href={s.enlace?.href}
          target={s.enlace?.target === '_blank' ? '_blank' : undefined}
          rel={s.enlace?.externo ? 'noopener noreferrer' : undefined}
        >
          {s.fondo?.imagen && (
            <img
              src={s.fondo.imagen}
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-cover"
            />
          )}
          {s.fondo?.color && !s.fondo?.imagen && (
            <div class="absolute inset-0" style={`background-color:${s.fondo.color}`} />
          )}

          {capasConContenido.map((c) => (
            c.tipo === 'texto' ? (
              <span
                class="banner-slider__capa absolute"
                style={estiloCapa(c, anchoLienzo, altoLienzo)}
                data-capa={c.uid}
                data-anim={c.animacion ? '' : undefined}
                data-loop={c.bucle ? c.bucle.tipo : undefined}
              >
                {/* Si el original traia HTML (texto + icono), se interpreta
                    saneado; si no, se pinta como texto normal. */}
                {c.textoConHtml ? <Fragment set:html={sanearHtml(c.texto)} /> : c.texto}
              </span>
            ) : (
              <img
                src={c.imagen!}
                alt={c.alt ?? ''}
                loading="lazy"
                decoding="async"
                class="banner-slider__capa absolute"
                style={estiloCapa(c, anchoLienzo, altoLienzo)}
                data-capa={c.uid}
                data-anim={c.animacion ? '' : undefined}
                data-loop={c.bucle ? c.bucle.tipo : undefined}
              />
            )
          ))}
        </Etiqueta>
      );
    })}
  </div>

  {slides.length > 1 && (
    <>
      <button
        type="button"
        data-accion="anterior"
        aria-label={etiquetaAnterior}
        class="banner-slider__flecha banner-slider__flecha--prev absolute top-1/2 z-20 -translate-y-1/2"
      >
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button
        type="button"
        data-accion="siguiente"
        aria-label={etiquetaSiguiente}
        class="banner-slider__flecha banner-slider__flecha--next absolute top-1/2 z-20 -translate-y-1/2"
      >
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>

      <ul class="banner-slider__puntos absolute bottom-4 z-20 flex w-full justify-center gap-2" role="tablist" aria-label={etiqueta}>
        {slides.map((_, i) => (
          <li>
            <button
              type="button"
              role="tab"
              data-accion="ir"
              data-indice={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`${i + 1} / ${slides.length}`}
              class="banner-slider__punto h-2.5 w-2.5 rounded-full"
            />
          </li>
        ))}
      </ul>
    </>
  )}
</div>

<style>
  /* Los estilos del componente viven CON EL, no en la hoja global: asi el
     componente se puede copiar a otro proyecto sin arrastrar nada mas. */
  .banner-slider {
    /* Las capas usan unidades de contenedor (cqw) para que el texto escale con el
       banner: sin esto,  se resuelve contra el viewport y el texto no guarda
       proporcion con las imagenes. */
    container-type: inline-size;
  }
  .banner-slider__capa {
    max-width: calc(100% - 2rem);
  }

  /*
   * ENTRADA DE UNA CAPA.
   *
   * SE ANIMA LA PROPIEDAD `translate`, NO `transform`. Es la clave y costo un
   * intento fallido: las capas ancladas ya usan `transform` para posicionarse, asi
   * que animar `transform` obliga a COMPONER los dos valores — y componerlos con
   * una variable que vale `none` produce `none translate(...)`, que **no es CSS
   * valido**: el navegador descarta la declaracion entera y solo se anima el
   * fundido, sin desplazamiento y sin ningun error visible.
   *
   * `translate`, `rotate` y `scale` son propiedades INDEPENDIENTES que se aplican
   * ademas de `transform`. Animando `translate` no hay conflicto posible con el
   * posicionamiento, y el desplazamiento de entrada funciona en los dos sistemas.
   */
  @keyframes bs-entrada {
    from {
      opacity: var(--bs-op0, 1);
      translate: var(--bs-x0, 0) var(--bs-y0, 0);
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /*
   * Solo se anima el slide ACTIVO. Al cambiar de slide, la regla pasa a aplicarse a
   * las capas de otro slide y el navegador REINICIA la animacion, que es justo lo
   * que se quiere: el escalonado vuelve a correr en cada banner.
   *
   * El retardo (`--bs-delay`) es lo que produce el escalonado, y la curva imita la
   * salida suave del plugin: arranca rapido y frena.
   */
  .banner-slider__slide[aria-hidden='false'] .banner-slider__capa[data-anim] {
    animation: bs-entrada var(--bs-dur, 600ms) cubic-bezier(0.22, 0.61, 0.36, 1)
      var(--bs-delay, 0ms) both;
  }

  /* Sin movimiento: las capas se muestran ya en su estado final, sin entrada. */
  @media (prefers-reduced-motion: reduce) {
    .banner-slider__slide[aria-hidden='false'] .banner-slider__capa[data-anim] {
      animation: none;
    }
  }


  /*
   * BUCLE. Se anima la MITAD del recorrido (el 50 %) para que la capa vuelva a su
   * estado original: sin ese "y vuelve", el elemento se quedaria encogido al
   * terminar cada ciclo. El `ease-in-out` hace que el latido acelere y frene, que
   * es lo que lo hace parecer un latido y no un parpadeo.
   */
  @keyframes bs-latido {
    50% { scale: var(--bs-loop, 1); }
  }
  @keyframes bs-giro {
    50% { rotate: calc(var(--bs-loop, 0) * 1deg); }
  }

  /* El bucle solo corre en el slide ACTIVO, y es infinito mientras lo este. */
  .banner-slider__slide[aria-hidden='false'] .banner-slider__capa[data-loop='escala'] {
    animation: bs-latido var(--bs-loop-dur, 1500ms) ease-in-out infinite;
  }
  .banner-slider__slide[aria-hidden='false'] .banner-slider__capa[data-loop='rotacion'] {
    animation: bs-giro var(--bs-loop-dur, 2500ms) ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-slider__slide[aria-hidden='false'] .banner-slider__capa[data-loop] {
      animation: none;
    }
  }

  .banner-slider__flecha {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    background: color-mix(in srgb, #000 45%, transparent);
    color: #fff;
    backdrop-filter: blur(2px);
  }
  .banner-slider__flecha:hover {
    background: color-mix(in srgb, #000 65%, transparent);
  }
  .banner-slider__flecha--prev {
    inset-inline-start: 1rem;
  }
  .banner-slider__flecha--next {
    inset-inline-end: 1rem;
  }
  .banner-slider__punto {
    background: color-mix(in srgb, #fff 55%, transparent);
    border: 0;
    cursor: pointer;
  }
  .banner-slider__punto[aria-selected='true'] {
    background: #fff;
  }

  /* Sin movimiento: nada de transiciones ni de fundidos. La preferencia del
     sistema se respeta de verdad, no solo en el carrusel de entrada. */
  @media (prefers-reduced-motion: reduce) {
    .banner-slider__slide {
      transition: none !important;
    }
  }
</style>

<script>
  /*
   * Comportamiento del carrusel.
   *
   * DETALLE QUE IMPORTA: el bucle usa `setTimeout` ajustado a la duracion de la
   * transicion, NO el evento `transitionend`. `transitionend` no dispara de forma
   * fiable en pestañas en segundo plano, y cuando eso pasa el indicador de
   * animacion se queda trabado y el carrusel deja de responder. Es un fallo que
   * solo aparece cuando el usuario cambia de pestaña, asi que se detecta tarde.
   */
  const DURACION_TRANSICION = 700;

  function iniciar(raiz) {
    const pista = raiz.querySelector('[data-pista]');
    if (!pista) return;
    const slides = [...raiz.querySelectorAll('[data-slide]')];
    if (slides.length < 2) return;

    const puntos = [...raiz.querySelectorAll('[data-indice]')];
    const intervalo = Number(raiz.dataset.intervalo) || 6000;
    const autoplay = raiz.dataset.autoplay === 'true';
    const bucle = raiz.dataset.bucle !== 'false';
    const pausaHover = raiz.dataset.pausaHover !== 'false';
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let actual = 0;
    let temporizador = null;
    let pausado = false;

    function mostrar(i, conTransicion = true) {
      if (i === actual) return;
      const anterior = actual;
      actual = i;

      if (!conTransicion || sinMovimiento) {
        slides[anterior].style.transition = 'none';
      }
      slides[anterior].classList.replace('opacity-100', 'opacity-0');
      slides[anterior].classList.add('pointer-events-none');
      slides[anterior].setAttribute('aria-hidden', 'true');

      slides[actual].classList.replace('opacity-0', 'opacity-100');
      slides[actual].classList.remove('pointer-events-none');
      slides[actual].setAttribute('aria-hidden', 'false');

      if (!conTransicion || sinMovimiento) {
        // Se fuerza un reflujo para que el navegador aplique el `transition:none`
        // antes de devolverlo, o la siguiente transicion se perderia.
        void slides[anterior].offsetWidth;
        slides[anterior].style.transition = '';
      }

      puntos.forEach((p, k) => p.setAttribute('aria-selected', k === actual ? 'true' : 'false'));
    }

    const siguiente = () => (actual + 1) % slides.length;
    const anterior = () => (actual - 1 + slides.length) % slides.length;

    function programar() {
      if (!autoplay || sinMovimiento || pausado || slides.length < 2) return;
      clearTimeout(temporizador);
      temporizador = setTimeout(() => {
        mostrar(siguiente());
        programar();
      }, intervalo);
    }

    raiz.addEventListener('click', (e) => {
      const boton = e.target.closest('[data-accion]');
      if (!boton) return;
      // Si el clic cae dentro del enlace del slide, no se intercepta: el usuario
      // quiere navegar, no cambiar de banner.
      if (e.target.closest('a[href]')) return;
      e.preventDefault();
      const accion = boton.dataset.accion;
      if (accion === 'siguiente') mostrar(siguiente());
      else if (accion === 'anterior') mostrar(anterior());
      else if (accion === 'ir') mostrar(Number(boton.dataset.indice));
      programar();
    });

    raiz.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { mostrar(siguiente()); programar(); }
      else if (e.key === 'ArrowLeft') { mostrar(anterior()); programar(); }
    });

    if (pausaHover) {
      raiz.addEventListener('mouseenter', () => { pausado = true; clearTimeout(temporizador); });
      raiz.addEventListener('mouseleave', () => { pausado = false; programar(); });
      // El foco tambien pausa: quien navega con teclado no debe ver como el
      // banner cambia bajo sus pies mientras lo esta leyendo.
      raiz.addEventListener('focusin', () => { pausado = true; clearTimeout(temporizador); });
      raiz.addEventListener('focusout', () => { pausado = false; programar(); });
    }

    // No se anima si la pestaña no esta visible: ahorra trabajo y evita que al
    // volver el carrusel haya saltado varios slides de golpe.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) clearTimeout(temporizador);
      else programar();
    });

    programar();
  }

  document.querySelectorAll('[data-banner-slider]').forEach(iniciar);
</script>
