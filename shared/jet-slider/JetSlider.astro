---
/*
 * JETSLIDER: el carrusel de tarjetas del original.
 *
 * QUE ES
 *   Un carrusel de UNA diapositiva a la vez, con flechas, cada una con una imagen a
 *   sangre y un titulo y un texto encima. Es distinto del carrusel de banners: alli
 *   las capas se colocan por coordenadas y aqui es una imagen con su texto centrado.
 *
 * POR QUE TIENE COMPONENTE PROPIO
 *   Se probo a pintarlo como rejilla de tarjetas para no dejar el contenido fuera, y
 *   el contenido estaba completo, pero la seccion medía el DOBLE que en el original
 *   (1622 px frente a 863) porque un carrusel de una fila se convertia en dos filas.
 *   Reutilizar el carrusel de banners no vale: su modelo son capas con posiciones, y
 *   esto es una imagen con un texto.
 *
 * TODO LO QUE SE PINTA ESTA MEDIDO EN EL ORIGINAL, no elegido:
 *   - alto 400 px (300 en tableta, 280 en movil), de `slider_height`
 *   - titulo a 75 px y peso 600, descripcion a 22,5 px, los dos blancos y centrados
 *   - contenido centrado en la diapositiva (flex, centrado en los dos ejes)
 *   - flechas de 53x53 circulares, fondo #003f7f y #ff7100 al pasar el raton, a 20 px del borde
 *   - puntos de 15x15, borde blanco y activo naranja, en una franja de 32 px bajo la imagen
 *   - avanza solo cada 5 s (`sliderAutoplayDelay` medido), con pausa al pasar el raton
 *
 * Las medidas de texto van en `cqw` (tanto por ciento del ancho del componente) para
 * que escalen con el, igual que en el carrusel de banners: en `px` se quedarian
 * clavadas al estrecharse la ventana y el titulo se saldria.
 */
interface Diapositiva {
  imagen?: string | null;
  titulo?: string | null;
  texto?: string | null;
  boton?: string | null;
}

interface Props {
  items: Diapositiva[];
  /** Alto del carrusel en pixeles, para cada corte. Salen de `slider_height`. */
  alto?: number | null;
  altoTableta?: number | null;
  altoMovil?: number | null;
  /** Velo sobre la imagen. El original usa un azul claro al 10 %. */
  veloColor?: string | null;
  veloOpacidad?: number | null;
  flechaFondo?: string | null;
  flechaFondoHover?: string | null;
  etiqueta?: string;
  etiquetaAnterior?: string;
  etiquetaSiguiente?: string;
}

const {
  items = [],
  alto = 400,
  altoTableta = 300,
  altoMovil = 280,
  veloColor = null,
  veloOpacidad = null,
  flechaFondo = null,
  flechaFondoHover = null,
  etiqueta = 'Carrusel',
  etiquetaAnterior = 'Anterior',
  etiquetaSiguiente = 'Siguiente',
} = Astro.props;

const diapositivas = items.filter((d) => d.imagen || d.titulo);
const id = `js-${Math.random().toString(36).slice(2, 8)}`;
const estiloAlto = `--js-alto:${alto ?? 400}px;--js-alto-t:${altoTableta ?? 300}px;--js-alto-m:${altoMovil ?? 280}px`;
---

{diapositivas.length > 0 && (
  <div
    class="jet-slider"
    id={id}
    data-jet-slider
    data-intervalo="5000"
    role="region"
    aria-roledescription="carrusel"
    aria-label={etiqueta}
    style={estiloAlto}
  >
    <div class="jet-slider__pista" data-pista>
      {diapositivas.map((d, i) => (
        <div
          class="jet-slider__diapo"
          data-diapo={i}
          aria-hidden={i === 0 ? 'false' : 'true'}
          aria-label={d.titulo ?? `Diapositiva ${i + 1} de ${diapositivas.length}`}
        >
          {d.imagen && (
            <img
              src={d.imagen}
              alt=""
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="jet-slider__imagen"
            />
          )}
          {veloColor && (
            <div
              class="jet-slider__velo"
              style={`background-color:${veloColor};opacity:${veloOpacidad ?? 1}`}
              aria-hidden="true"
            />
          )}
          <div class="jet-slider__contenido">
            {d.titulo && <h5 class="jet-slider__titulo">{d.titulo}</h5>}
            {d.texto && <p class="jet-slider__texto">{d.texto}</p>}
          </div>
        </div>
      ))}
    </div>

    {diapositivas.length > 1 && (
      <>
        <button type="button" class="jet-slider__flecha jet-slider__flecha--antes" data-anterior aria-label={etiquetaAnterior}>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button type="button" class="jet-slider__flecha jet-slider__flecha--despues" data-siguiente aria-label={etiquetaSiguiente}>
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        {/* Puntos del original: 15x15, borde blanco de 2 px, activo naranja. */}
        <div class="jet-slider__puntos" role="tablist" aria-label={etiqueta}>
          {diapositivas.map((_, i) => (
            <button
              type="button"
              role="tab"
              class="jet-slider__punto"
              data-indice={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`${i + 1} / ${diapositivas.length}`}
            />
          ))}
        </div>
      </>
    )}
  </div>
)}

<style>
  /*
   * El estilo del componente vive CON EL, igual que en el carrusel de banners, para
   * que se pueda copiar a otro proyecto sin arrastrar nada mas.
   */
  .jet-slider {
    position: relative;
    overflow: hidden;
    width: 100%;
    /* El original mide 432 de alto: 400 de imagen + 32 de la franja de puntos. */
    height: calc(var(--js-alto, 400px) + 32px);
    /* Para que el texto en `cqw` escale con el ancho del carrusel. */
    container-type: inline-size;
    background-color: transparent;
  }
  @media (max-width: 1023px) {
    .jet-slider { height: calc(var(--js-alto-t, 300px) + 32px); }
  }
  @media (max-width: 767px) {
    .jet-slider { height: calc(var(--js-alto-m, 280px) + 32px); }
  }

  .jet-slider__pista {
    display: flex;
    height: var(--js-alto, 400px);
    transition: transform 500ms cubic-bezier(0.22, 0.61, 0.36, 1);
    background-color: #54595f;
  }
  @media (max-width: 1023px) {
    .jet-slider__pista { height: var(--js-alto-t, 300px); }
  }
  @media (max-width: 767px) {
    .jet-slider__pista { height: var(--js-alto-m, 280px); }
  }
  .jet-slider__diapo {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
  }
  .jet-slider__imagen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .jet-slider__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* Contenido centrado en los dos ejes, como en el original. */
  .jet-slider__contenido {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding-inline: 8cqw;
    text-align: center;
  }
  /* 75 px sobre un lienzo de 1026 = 7,31 cqw; 22,5 px = 2,19 cqw. */
  .jet-slider__titulo {
    margin: 0;
    font-size: 7.31cqw;
    font-weight: 600;
    line-height: 1.1;
    color: #ffffff;
  }
  .jet-slider__texto {
    margin: 0;
    max-width: 70%;
    font-size: 2.19cqw;
    line-height: 1.2;
    color: #ffffff;
  }

  /* Flechas: 53x53 circulares, a 20 px del borde y centradas en la IMAGEN
     (no en el total, que incluye la franja de puntos). */
  .jet-slider__flecha {
    position: absolute;
    top: calc((100% - 32px) / 2);
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 53px;
    height: 53px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    color: #ffffff;
    background-color: var(--js-flecha, #003f7f);
    transition: background-color 200ms ease;
  }
  .jet-slider__flecha:hover,
  .jet-slider__flecha:focus-visible {
    background-color: var(--js-flecha-hover, #ff7100);
  }
  .jet-slider__flecha--antes { inset-inline-start: 20px; }
  .jet-slider__flecha--despues { inset-inline-end: 20px; }

  /* Puntos: 15x15 con borde blanco de 2 px; el activo, relleno naranja. */
  .jet-slider__puntos {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    z-index: 2;
  }
  .jet-slider__punto {
    width: 15px;
    height: 15px;
    padding: 0;
    border: 2px solid #ffffff;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .jet-slider__punto[aria-selected='true'] {
    background: #ff7100;
  }

  @media (prefers-reduced-motion: reduce) {
    .jet-slider__pista { transition: none; }
  }
</style>

<script>
  /*
   * Comportamiento del carrusel.
   *
   * AVANZA SOLO CADA 5 SEGUNDOS: es el `sliderAutoplayDelay` que declara el propio
   * widget en el original (`sliderAutoplay: true`, `sliderAutoplayOnHover: pause`).
   * Una medición anterior había concluido lo contrario porque la ventana de espera
   * era más corta que el intervalo; dos capturas separadas 3 s lo desmintieron.
   *
   * Los botones se crean en el marcado y aquí solo se les da vida, para que el
   * carrusel funcione igual si el guion no llega a cargar (se vería la primera
   * diapositiva, que es lo que se ve sin JavaScript).
   */
  function activar(raiz: HTMLElement) {
    if (raiz.dataset.listo === 'si') return;
    raiz.dataset.listo = 'si';

    const pista = raiz.querySelector<HTMLElement>('[data-pista]');
    const diapos = [...raiz.querySelectorAll<HTMLElement>('[data-diapo]')];
    if (!pista || diapos.length < 2) return;

    const puntos = [...raiz.querySelectorAll<HTMLElement>('[data-indice]')];
    const intervalo = Number(raiz.dataset.intervalo) || 5000;
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actual = 0;
    let temporizador: ReturnType<typeof setTimeout> | null = null;
    let pausado = false;

    const ir = (i: number) => {
      actual = (i + diapos.length) % diapos.length;
      pista.style.transform = `translateX(${-actual * 100}%)`;
      diapos.forEach((d, k) => d.setAttribute('aria-hidden', k === actual ? 'false' : 'true'));
      puntos.forEach((p, k) => p.setAttribute('aria-selected', k === actual ? 'true' : 'false'));
    };

    function programar() {
      if (sinMovimiento || pausado) return;
      if (temporizador) clearTimeout(temporizador);
      temporizador = setTimeout(() => {
        ir(actual + 1);
        programar();
      }, intervalo);
    }

    const navegar = (i: number) => { ir(i); programar(); };

    raiz.querySelector('[data-anterior]')?.addEventListener('click', () => navegar(actual - 1));
    raiz.querySelector('[data-siguiente]')?.addEventListener('click', () => navegar(actual + 1));
    puntos.forEach((p) => p.addEventListener('click', () => navegar(Number(p.dataset.indice))));

    // Con el teclado, cuando el foco esta dentro del carrusel
    raiz.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { navegar(actual - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { navegar(actual + 1); e.preventDefault(); }
    });

    // Arrastrar con el raton o el dedo, que es lo que hace un carrusel de verdad
    let inicio: number | null = null;
    raiz.addEventListener('pointerdown', (e) => { inicio = e.clientX; });
    raiz.addEventListener('pointerup', (e) => {
      if (inicio === null) return;
      const recorrido = e.clientX - inicio;
      inicio = null;
      if (Math.abs(recorrido) > 40) navegar(actual + (recorrido < 0 ? 1 : -1));
    });

    // Pausa al pasar el ratón o al entrar con el teclado, como el original.
    raiz.addEventListener('mouseenter', () => { pausado = true; if (temporizador) clearTimeout(temporizador); });
    raiz.addEventListener('mouseleave', () => { pausado = false; programar(); });
    raiz.addEventListener('focusin', () => { pausado = true; if (temporizador) clearTimeout(temporizador); });
    raiz.addEventListener('focusout', () => { pausado = false; programar(); });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) { if (temporizador) clearTimeout(temporizador); }
      else programar();
    });

    programar();
  }

  const arrancar = () => document.querySelectorAll<HTMLElement>('[data-jet-slider]').forEach(activar);
  arrancar();
  document.addEventListener('astro:page-load', arrancar);
</script>
